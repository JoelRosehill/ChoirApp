# Your domain; its DNS A/AAAA record must point at this server. Ports 80 and 443 must be open.
DOMAIN=koris.example.lv
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.lv

# Shown in the header and on the home-screen icon.
CHOIR_NAME=Koris
# Password for the director page (/vaditajs).
DIRECTOR_PASSWORD=change-me
# Contact for push services (required by the Web Push standard).
PUSH_CONTACT=mailto:you@example.lv

# Optional: Android app (TWA). See README.
# ANDROID_PACKAGE=lv.koris.app
# ANDROID_CERT_SHA256=AB:CD:...
